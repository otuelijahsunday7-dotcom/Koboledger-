name: "KoboLedger =E2=80=94 Business Pocket Assistant",

short_name: "KoboLedger",

description: "International multi-currency ledger, multi-item cart, expense
& debt tracker, and AI assistant.",

start_url: "/",

scope: "/",

display: "standalone",

background_color: "#F3F4F6",

theme_color: "#059669",

orientation: "portrait-primary",

icons: [

