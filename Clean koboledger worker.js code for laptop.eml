=E2=80=8Bconst SERVICE_WORKER_JS =3D `

const CACHE_NAME =3D "koboledger-pwa-v1";

const STATIC_ASSETS =3D ["/", "/manifest.json", "/icon-192.png",
"/icon-512.png"];

=E2=80=8Bself.addEventListener("install", (event) =3D> {

event.waitUntil(

caches.open(CACHE_NAME).then((cache) =3D>
cache.addAll(STATIC_ASSETS)).then(() =3D> self.skipWaiting())

);

});

=E2=80=8Bself.addEventListener("activate", (event) =3D> {

event.waitUntil(

caches.keys().then((keys) =3D>

Promise.all(keys.filter((k) =3D> k !=3D=3D CACHE_NAME).map((k) =3D>
caches.delete(k)))

).then(() =3D> self.clients.claim())

);

});

=E2=80=8Bself.addEventListener("fetch", (event) =3D> {

if (event.request.method !=3D=3D "GET") return;

const url =3D new URL(event.request.url);

if (url.pathname.startsWith("/api/")) return;

=E2=80=8Bevent.respondWith(

caches.match(event.request).then((cached) =3D> {

if (cached) return cached;

return fetch(event.request)

.then((response) =3D> {

if (response && response.status =3D=3D=3D 200 && url.origin =3D=3D=3D
self.location.origin) {

const clone =3D response.clone();

caches.open(CACHE_NAME).then((cache) =3D> cache.put(event.request, clone));

}

return response;

})

.catch(() =3D> caches.match("/"));

})

);

});

`;

